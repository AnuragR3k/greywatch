# Greywatch backend environment — staging deployment.
#
# Copy to backend/.env and fill in the secrets. systemd reads this via
# EnvironmentFile=/etc/greywatch/greywatch.env.
#
# WARNING: Never commit real values to version control. .env is gitignored
# (.gitignore line 4). This .env.example contains placeholders only.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Isolated database OUTSIDE the repository. Never use data/greywatch.db for
# tests or deployment validation; tests use isolated temp databases via the
# conftest autouse guard.
GREYWATCH_DB=/var/lib/greywatch/greywatch.db

# ---------------------------------------------------------------------------
# API authentication (required for remote/token mode)
# ---------------------------------------------------------------------------
# Generate with: scripts/generate_staging_token.sh
# Written to /etc/greywatch/greywatch.env (mode 0600, root).
# The SAME token must also be set in Caddy's environment so Caddy can inject
# it server-side when proxying /api/* to the backend. The browser never sees
# the token.
# Never echo, log, or bundle this value.
GREYWATCH_API_TOKEN=REPLACE_ME_WITH_GENERATED_TOKEN

# Loopback trust boundary. Leave 1 (default) so remote peers require the
# token. Set to 0 ONLY behind an authenticating reverse proxy that performs
# its own access control (then the proxy is the trust boundary).
GREYWATCH_API_LOOPBACK_ONLY=1

# ---------------------------------------------------------------------------
# Rate limiting (enabled by default; disabling is an explicit operator choice)
# ---------------------------------------------------------------------------
GREYWATCH_RATE_LIMIT_ENABLED=1
GREYWATCH_RATE_LIMIT_INGESTION=60
GREYWATCH_RATE_LIMIT_READS=120
GREYWATCH_RATE_LIMIT_COLLECTOR=30
GREYWATCH_RATE_LIMIT_ALERT_CLOSE=30
GREYWATCH_RATE_LIMIT_BURST_MULTIPLIER=2

# ---------------------------------------------------------------------------
# Request body limit (default 1 MiB; 0 disables = explicit operator choice)
# ---------------------------------------------------------------------------
GREYWATCH_MAX_REQUEST_BYTES=1048576

# ---------------------------------------------------------------------------
# Collectors (optional, off by default)
# ---------------------------------------------------------------------------
GREYWATCH_JOURNAL_ENABLED=0
GREYWATCH_SURICATA_ENABLED=0

# ---------------------------------------------------------------------------
# Incident correlation window (minutes)
# ---------------------------------------------------------------------------
GREYWATCH_CORRELATION_WINDOW_MINUTES=30
