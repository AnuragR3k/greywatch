# Greywatch frontend configuration.
#
# The frontend never holds a secret: any VITE_* value is compiled into the
# public JS bundle. Never put an API token or credential in this file.

# API base URL. Leave unset for local development — the Vite dev server proxies
# /api and /health to http://127.0.0.1:8000 (see vite.config.js). Set it only
# for same-origin production wiring or a non-secret gateway host.
# VITE_API_BASE_URL=
